# ==========================================================================
# VELOCITY SAAS LANDING PAGE - ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your values
# ==========================================================================

# --------------------------------------------------------------------------
# APP CONFIGURATION
# --------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://velocity.dev
NEXT_PUBLIC_APP_NAME=Velocity
NEXT_PUBLIC_APP_DESCRIPTION="The development platform that turns weeks of work into hours."

# --------------------------------------------------------------------------
# ANALYTICS
# --------------------------------------------------------------------------
# Google Analytics 4
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Plausible Analytics (alternative to GA)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=velocity.dev
NEXT_PUBLIC_PLAUSIBLE_API_HOST=https://plausible.io

# --------------------------------------------------------------------------
# ERROR TRACKING (Sentry)
# --------------------------------------------------------------------------
SENTRY_DSN=https://xxx@sentry.io/xxx
NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx
SENTRY_ORG=velocity
SENTRY_PROJECT=landing-page
SENTRY_AUTH_TOKEN=xxx

# --------------------------------------------------------------------------
# EMAIL / NEWSLETTER
# --------------------------------------------------------------------------
# Resend
RESEND_API_KEY=re_xxx
NEWSLETTER_FROM_EMAIL=newsletter@velocity.dev

# Or ConvertKit
CONVERTKIT_API_KEY=xxx
CONVERTKIT_FORM_ID=xxx

# --------------------------------------------------------------------------
# DATABASE (if needed for waitlist/signups)
# --------------------------------------------------------------------------
DATABASE_URL=postgresql://user:pass@host:5432/velocity

# --------------------------------------------------------------------------
# AUTH (if adding authentication later)
# --------------------------------------------------------------------------
NEXTAUTH_SECRET=xxx
NEXTAUTH_URL=https://velocity.dev

# GitHub OAuth
GITHUB_ID=xxx
GITHUB_SECRET=xxx

# Google OAuth
GOOGLE_ID=xxx
GOOGLE_SECRET=xxx

# --------------------------------------------------------------------------
# PAYMENTS (Stripe)
# --------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe Price IDs
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_PRO_YEARLY=price_xxx
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_xxx
STRIPE_PRICE_ENTERPRISE_YEARLY=price_xxx

# --------------------------------------------------------------------------
# FEATURE FLAGS
# --------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_AI_REVIEWS=true
NEXT_PUBLIC_ENABLE_EDGE_FUNCTIONS=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# --------------------------------------------------------------------------
# CDN / ASSETS
# --------------------------------------------------------------------------
NEXT_PUBLIC_CDN_URL=https://cdn.velocity.dev

# --------------------------------------------------------------------------
# DEVELOPMENT
# --------------------------------------------------------------------------
NODE_ENV=development